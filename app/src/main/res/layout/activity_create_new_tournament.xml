<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Admin.CreateNewTournament"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/lightYellow">
<!--Fields include name, category, difficulty, start date,
end date and rating ( 1 to 5
-->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create new Quiz Tournament"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginVertical="16sp"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70sp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="50sp"

            >

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="10sp"
                android:backgroundTint="@color/lightGreen"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginVertical="5sp"
                    android:layout_marginHorizontal="10sp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quiz Tournament Name:"
                        android:textColor="@color/black"
                        />
                    <EditText
                        android:id="@+id/etNewQuizName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="i.e. General Knowledge"
                        android:textColor="@color/black"
                        android:textStyle="normal"
                        android:textSize="18sp"
                        />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="10sp"
                android:backgroundTint="@color/lightGreen"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginVertical="5sp"
                    android:layout_marginHorizontal="10sp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Question Category:"
                        android:textColor="@color/black"
                        />
                    <Spinner
                        android:id="@+id/spnrNewQuizCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginBottom="5sp"
                        />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="10sp"
                android:backgroundTint="@color/lightGreen"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginVertical="5sp"
                    android:layout_marginHorizontal="10sp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Difficulty:"
                        android:textColor="@color/black"
                        />
                    <Spinner
                        android:id="@+id/spnrNewQuizDifficulty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginBottom="5sp"
                        />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="10sp"
                android:backgroundTint="@color/lightGreen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="10sp"
                    android:layout_marginVertical="5sp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Date:"
                        android:textColor="@color/black" />

                    <DatePicker
                        android:id="@+id/dpNewQuizStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="169sp"
                        android:calendarViewShown="false"
                        android:datePickerMode="spinner"
                        android:scaleX="1"
                        android:spinnersShown="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16sp"
                android:layout_marginBottom="10sp"
                android:backgroundTint="@color/lightGreen"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginVertical="5sp"
                    android:layout_marginHorizontal="10sp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End Date:"
                        android:textColor="@color/black"
                        />

                    <DatePicker
                        android:id="@+id/dpNewQuizEndDate"
                        android:layout_width="match_parent"
                        android:layout_height="169sp"
                        android:calendarViewShown="false"
                        android:datePickerMode="spinner"
                        android:scaleX="1"
                        android:spinnersShown="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

<!--            <com.google.android.material.card.MaterialCardView-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginHorizontal="16sp"-->
<!--                android:layout_marginBottom="10sp"-->
<!--                android:backgroundTint="@color/lightGreen"-->
<!--                >-->
<!--                <LinearLayout-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:orientation="vertical"-->
<!--                    android:layout_marginVertical="5sp"-->
<!--                    android:layout_marginHorizontal="10sp"-->
<!--                    >-->
<!--                    <TextView-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:text="Quiz Rating:"-->
<!--                        android:textColor="@color/black"-->
<!--                        />-->

<!--                    <RatingBar-->
<!--                        android:id="@+id/rbTournamentRating"-->
<!--                        android:layout_width="243dp"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:numStars="5"-->
<!--                        android:rating="0.5"-->
<!--                        android:stepSize="1"-->
<!--                        android:progressTint="@color/Yellow"-->
<!--                        />-->
<!--                </LinearLayout>-->
<!--            </com.google.android.material.card.MaterialCardView>-->
        </LinearLayout>
    </ScrollView>


    <Button
        android:id="@+id/btnCreateQuiz"
        android:layout_width="match_parent"
        android:layout_height="50sp"
        android:text="Create Quiz Tournament"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginTop="-60sp"
        android:layout_marginHorizontal="16sp"
        />


</LinearLayout>